dist/
build/
out/
.parcel-cache/
.next/
.nuxt/
bin/
obj/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Environment & Security (Fallback Security) ---
.env
.env*
.env.*.local
.env.local
*.pem
*.key
cert.ppk
auth.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# --- Design Tools (Figma / Framer / Webflow) ---
*.fig
*.framer
.webflow/
.import/

# --- Automation & Archives ---
# Prevents re-uploading the zips created by your release.yml
*.zip
*.tar.gz
*.rar
*.7z

# --- Custom Logic Preservation ---
# Ensure README.md is NEVER ignored as it is your release note source
!app/README.md
!*/README.md
